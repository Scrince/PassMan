# macOS metadata
.DS_Store
._*

# Local agent guidance file
AGENTS.md

# PyInstaller-generated, version-specific spec files
/PassMan-*.spec

# Python caches and environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/

# Build outputs and local release artifacts
build/
dist/
/release/

# Top-level branding kit only (application icons live under src/assets/).
/assets/
*.log

# Local encrypted vault data
vault.dat
vault.dat.bak
vault.dat.*
**/vault.dat
**/vault.dat.bak
**/vault.dat.*

# Repo-local GPG release keyring: keep private/volatile material out of git.
.gnupg-release/

# Private keys and certificate bundles
*.key
*.pem
*.pfx
*.p12
