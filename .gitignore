# macOS metadata
.DS_Store
._*

# Local agent guidance file
AGENTS.md

# PyInstaller-generated, version-specific spec files
/PassMan-*.spec

# Python caches and environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/

build/
dist/
/release/
# Top-level branding kit only (application icons live under src/assets/).
/assets/
*.log

# Local encrypted vault data
*.dat
*.dat.*
*.bak
*.bak.*
vault.dat
vault.dat.bak
vault.dat.*

# Repo-local GPG release keyring: keep private/volatile material out of git.
.gnupg-release/

# Private keys and certificate bundles
*.key
*.pem
*.pfx
*.p12
# Runtime vault data must always be ignored.
**/vault.dat
**/vault.dat.bak
**/vault.dat.*

# Release artifacts are stored on GitHub Releases, not tracked in source Git.
/release/
